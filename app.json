{
  "expo": {
    "name": "Superlista",
    "slug": "superlista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "shortName": "Superlista",
      "themeColor": "#4CAF50",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "bundler": "metro"
    }
  }
}
